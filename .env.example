# Copy to .env and populate privately. Never commit .env.
HOST=127.0.0.1
PORT=3000
SERVER_API_KEY=

# API Connect 10.0.8.10 native Analytics API via the Platform API origin.
# Origin only (no /api). Token needs api-analytics:view at the catalog scope.
APIC_PLATFORM_URL=https://apic-platform.example.com
APIC_ANALYTICS_SERVICE=analytics-service-name-or-id
APIC_ORG=provider-org-name-or-id
APIC_CATALOG=catalog-name-or-id
# Use transaction_id instead if the supplied ID is a gateway-local transaction ID.
# The HTTP JSON key is always transaction_id, independent of this Analytics field.
APIC_TRANSACTION_FIELD=global_transaction_id

# Native API Connect document endpoint, including org/catalog context as needed.
# apiId comes from api_ref (name:version), or a uniquely resolved published API ID.
# org/catalog use the configured scope, validated against transaction metadata.
# The token also needs product:view.
APIC_SPEC_URL_TEMPLATE=https://apic-platform.example.com/api/catalogs/{org}/{catalog}/apis/{apiId}/document
# Optional for nonstandard Management routing. Native name-list URL is derived
# automatically from .../apis/{apiId}/document when this setting is omitted.
# APIC_API_LIST_URL_TEMPLATE=https://apic-platform.example.com/api/catalogs/{org}/{catalog}/apis/{apiName}
APIC_TOKEN=

# OpenAI-compatible connector: exact Chat Completions URL, not base URL.
LLM_URL=https://llm-connector.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
UPSTREAM_TIMEOUT_MS=20000
MAX_CONCURRENT_ANALYSES=4
SHUTDOWN_TIMEOUT_MS=90000

# For private CA deployments use NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem.
# Preserve HTTPS_PROXY/HTTP_PROXY and NO_PROXY (include loopback for local calls).

# Optional approved sanitization policy (JSON); omit to use config/sanitization-policy.json.
# DATA_POLICY_FILE=/etc/support-bot/sanitization-policy.json
