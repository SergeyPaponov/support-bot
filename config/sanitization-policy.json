{
  "version": 1,
  "defaultAction": "exclude",
  "limits": { "maxFieldChars": 4096, "maxDepth": 12, "maxNodes": 12000, "maxFindings": 200, "maxPatternChars": 512, "regexTimeoutMs": 100 },
  "freeText": "classify",
  "rules": [
    { "path": "/spec/openapi", "action": "allow" },
    { "path": "/spec/swagger", "action": "allow" },
    { "path": "/spec/**/type", "action": "allow" },
    { "path": "/spec/**/required", "action": "allow" },
    { "path": "/spec/**/minLength", "action": "allow" },
    { "path": "/spec/**/maxLength", "action": "allow" },
    { "path": "/spec/**/minimum", "action": "allow" },
    { "path": "/spec/**/maximum", "action": "allow" },
    { "path": "/spec/**/nullable", "action": "allow" },
    { "path": "/spec/**/in", "action": "allow" },
    { "path": "/spec/**/name", "action": "allow" },
    { "path": "/logs/*/data/status", "action": "allow", "values": [200, 201, 202, 204, 301, 302, 304, 400, 401, 403, 404, 405, 409, 415, 422, 429, 500, 502, 503, 504] },
    { "path": "/logs/*/data/status_code", "action": "allow", "values": ["200 OK", "201 Created", "400 Bad Request", "401 Unauthorized", "403 Forbidden", "404 Not Found", "500 Internal Server Error", "502 Bad Gateway", "503 Service Unavailable"] },
    { "path": "/logs/*/data/method", "action": "allow", "values": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    { "path": "/logs/*/data/message", "action": "allow" },
    { "path": "/logs/*/data/error_message", "action": "allow" },
    { "path": "/logs/*/data/error_description", "action": "allow" },
    { "path": "/logs/*/data/event", "action": "sanitize_nested" },
    { "path": "/logs/*/data/event/status_code", "action": "allow", "values": ["200 OK", "400 Bad Request", "401 Unauthorized", "403 Forbidden", "404 Not Found", "500 Internal Server Error", "502 Bad Gateway", "503 Service Unavailable"] },
    { "path": "/logs/*/data/event/method", "action": "allow", "values": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    { "path": "/logs/*/data/event/error_message", "action": "allow" },
    { "path": "/logs/*/data/request_body", "action": "sanitize_nested" },
    { "path": "/logs/*/data/event/request_body", "action": "sanitize_nested" },
    { "path": "/logs/*/data/request_body/accountNumber", "action": "shape_and_validate" },
    { "path": "/logs/*/data/request_body/customerId", "action": "shape_and_validate" },
    { "path": "/logs/*/data/event/request_body/accountNumber", "action": "shape_and_validate" },
    { "path": "/logs/*/data/event/request_body/customerId", "action": "shape_and_validate" }
  ]
}
